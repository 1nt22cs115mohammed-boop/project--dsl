{
  "name": "threejs-cad-tools",
  "version": "1.0.0",
  "description": "CAD-like modeling tools for Three.js - Create walls, pyramids, chimneys, windows and perform extrude, revolve operations",
  "main": "dist/threejs-cad-tools.min.js",
  "module": "src/index.js",
  "types": "types/index.d.ts",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "build:esm": "rollup -c",
    "examples": "http-server examples/ -p 8080 -o",
    "lint": "eslint src/",
    "test": "jest"
  },
  "keywords": [
    "threejs",
    "cad",
    "3d-modeling",
    "architecture",
    "extrude",
    "revolve",
    "boolean-operations",
    "3d",
    "webgl",
    "geometry",
    "wall",
    "pyramid",
    "chimney",
    "window"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/threejs-cad-tools"
  },
  "peerDependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "babel-loader": "^10.0.0",
    "eslint": "^8.57.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "rollup": "^3.29.4",
    "webpack": "^5.102.1",
    "webpack-cli": "^5.1.4"
  },
  "files": [
    "dist/",
    "src/",
    "types/",
    "README.md",
    "LICENSE"
  ]
}
